# Credenciales de Claude. Sin ninguna de estas, la app contesta con las
# respuestas fijas del prototipo (modo "kb").
ANTHROPIC_API_KEY=

# Fuerza el modo de respuesta: claude | kb  (opcional)
# PAVA_ANSWER_MODE=kb

# Contraseña de /admin. Sin ella, /admin no admite a nadie.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión de /admin (opcional; si falta se deriva de la contraseña).
# ADMIN_SESSION_SECRET=

# Carpeta donde se guarda el registro de preguntas (por defecto ./data).
# PAVA_DATA_DIR=./data

# Tiempo máximo de espera de una respuesta antes de mostrar el estado de error, en ms.
# NEXT_PUBLIC_ASK_TIMEOUT_MS=10000
